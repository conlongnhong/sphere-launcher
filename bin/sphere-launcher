#!/usr/bin/env bash
# Holographic Sphere Launcher CLI Entry Point
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SPHERE_MAIN=""

# Search order for main.py
if [ -n "${SPHERE_DIR:-}" ] && [ -f "$SPHERE_DIR/main.py" ]; then
    SPHERE_MAIN="$SPHERE_DIR/main.py"
elif [ -f "$SCRIPT_DIR/../sphere_launcher/main.py" ]; then
    SPHERE_MAIN="$SCRIPT_DIR/../sphere_launcher/main.py"
elif [ -f "$HOME/.local/share/sphere-launcher/main.py" ]; then
    SPHERE_MAIN="$HOME/.local/share/sphere-launcher/main.py"
elif [ -f "/usr/share/sphere-launcher/main.py" ]; then
    SPHERE_MAIN="/usr/share/sphere-launcher/main.py"
elif [ -f "/usr/local/share/sphere-launcher/main.py" ]; then
    SPHERE_MAIN="/usr/local/share/sphere-launcher/main.py"
else
    echo "[SphereLauncher] Error: Could not locate main.py. Ensure sphere-launcher is properly installed." >&2
    exit 1
fi

exec python3 -u "$SPHERE_MAIN" "$@"
